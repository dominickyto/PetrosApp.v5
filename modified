        // One-time import of events saved by the previous version of this page
        function migrateOldEvents() {
            if (store.get('petros_events_migrated_v2')) return;
            const old = readJSON('petros_calendar_events', null);
            if (Array.isArray(old)) {
                const defaultIds = DEFAULT_EVENTS.map(e => e.id);
                old.forEach(e => {
                    if (!e || defaultIds.includes(e.id)) return;
                    const y = parseInt(e.year, 10), m = parseInt(e.month, 10);
                    if (!y || !m) return;
                    userEvents.push({
                        id: 'u' + (e.id || Date.now() + Math.random()), start: y + '-' + pad2(m) + '-01', end: '', time: '',
                        cat: LEGACY_CAT_MAP[e.category] || 'regular',
                        title: { zh: e.title || '', en: '' }, desc: { zh: e.description || '', en: '' }, loc: { zh: e.location || '', en: '' },
                        dateText: e.date || ''
                    });
                });
                persistEvents();
            }
            store.set('petros_events_migrated_v2', '1');
        }
        function getEvents() {
            const defs = DEFAULT_EVENTS.filter(e => !deletedIds.includes(e.id)).map(e => {
                const o = overrides[e.id];
                return Object.assign({}, o ? o : e, { id: e.id, isDefault: true, edited: !!o });
            });
            const mine = userEvents.map(e => Object.assign({}, e, { isDefault: false }));
            return defs.concat(mine).sort((a, b) => String(a.start).localeCompare(String(b.start)));
        }
        function findEvent(id) { return getEvents().find(e => String(e.id) === String(id)); }
        const evYear = e => parseInt(String(e.start).slice(0, 4), 10);
        const evMonth = e => parseInt(String(e.start).slice(5, 7), 10);

        function fmtDate(iso) {
            const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || '');
            if (!m) return iso || '';
            try {
                return new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'zh-HK', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' })
                    .format(new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])));
            } catch (e) { return iso; }
        }
        function eventDateText(e) {
            if (e.dateText) return e.dateText;
            let s = fmtDate(e.start);
            if (e.end && e.end !== e.start) s += ' – ' + fmtDate(e.end);
            if (e.time) s += ' · ' + e.time;
            return s;
        }
        const catLabel = key => L(CATS[key] || CATS.regular);

