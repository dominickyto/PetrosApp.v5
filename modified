            { id: 'crisisless-placeholder', skip: true },
            { id: 'work', icon: 'fa-briefcase', label: { zh: '職場壓力', en: 'Work stress' },
              kw: { zh: ['工作', '職場', '上司', '老闆', '同事', '加班', '失業', '裁員', '事業', '辭職', '倦怠', '生意', '公司', '業績', '打工'], en: ['work', 'job', 'boss', 'career', 'burnout', 'colleague', 'deadline', 'overwork', 'layoff', 'office', 'business', 'workplace'] },
              open: { zh: '工作的壓力、期望與責任，常常令人透不過氣。你願意說出來，已經是向前走的一步。', en: 'The pressure, expectations and responsibilities of work can leave a man short of breath. Putting it into words is already a step forward.' },
              verses: ['mt11_28', 'ps127_1', 'col3_23'],
              reflect: { zh: '男士往往把自己的價值建基於業績與身份。聖詠 127 提醒我們：若不是上主建造，勞苦便是白費。這不是叫我們少做，而是把成敗交託給天主，專注做好眼前的責任，並容許自己休息。', en: 'Men often build their worth on performance and position. Psalm 127 reminds us that unless the LORD builds, our labor is in vain. This is not a call to do less, but to entrust success and failure to God, to do today\'s duty well, and to allow ourselves to rest.' },
              steps: { zh: ['上班前用一分鐘，把今天最重要的一件事交託給天主。', '午休或下班時刻意停下來，慢慢呼吸三次，默念：「主，我信賴你。」', '找一位信得過的弟兄飯聚傾談，不要獨自承擔。'], en: ['Before work, take one minute to place the most important task of the day in God\'s hands.', 'At lunch or when you leave work, pause, breathe slowly three times and pray: “Lord, I trust you.”', 'Meet a trusted brother for a meal and talk; do not carry it alone.'] },
              prayer: { zh: '主耶穌，我把今天的工作、同事和決定交在你手中。求你賜我智慧、耐性與平安，使我做事誠實，也懂得休息。阿們。', en: 'Lord Jesus, I place my work, my colleagues and my decisions in your hands. Give me wisdom, patience and peace; help me work honestly and also to rest. Amen.' },
              related: ['perseverance', 'anxiety'] },

            { id: 'anxiety', icon: 'fa-cloud-rain', label: { zh: '焦慮與擔憂', en: 'Anxiety & worry' },
              kw: { zh: ['焦慮', '擔心', '憂慮', '擔憂', '害怕', '恐懼', '不安', '緊張', '失眠', '睡不著', '驚', '慌', '壓力'], en: ['anxious', 'anxiety', 'worry', 'worried', 'afraid', 'fear', 'nervous', 'panic', 'insomnia', 'scared', 'stress', 'stressed'] },
              open: { zh: '擔憂的時候，心很容易被未來的種種「如果」佔滿。你並不孤單，天主願意與你同行。', en: 'When we worry, the heart fills up with “what ifs” about the future. You are not alone; God wants to walk with you.' },
              verses: ['phil4_6', 'pt5_7', 'mt6_34', 'is41_10', 'ps27_1'],
              reflect: { zh: '祈禱不是叫憂慮消失，而是把憂慮放到天主手上。保祿說，天主的平安「出人意外」，不一定先解決問題，卻能守護我們的心。', en: 'Prayer does not make worries vanish; it places them in God\'s hands. Paul says God\'s peace surpasses understanding: it may not solve the problem first, but it guards our hearts.' },
              steps: { zh: ['把擔心的事逐一寫下，分成「我能做的」和「我要交託的」。', '睡前念一遍：「主，我把今天交給你。」', '若焦慮持續影響睡眠或生活，請同時向醫生或輔導員求助。'], en: ['Write down what worries you and sort it into “what I can do” and “what I must entrust to God”.', 'Before sleep, pray: “Lord, I give this day to you.”', 'If anxiety keeps affecting your sleep or daily life, please also seek help from a doctor or counsellor.'] },
              prayer: { zh: '天主，我的心很不安。求你安靜我的思緒，讓我記得你與我同在。我把擔憂交給你，求你賜我今天所需要的力量。阿們。', en: 'God, my heart is restless. Quiet my thoughts and let me remember that you are with me. I give you my worries; grant me the strength I need for today. Amen.' },
              related: ['rock', 'prayer'] },

            { id: 'family', icon: 'fa-house-chimney', label: { zh: '家庭、婚姻與子女', en: 'Family & marriage' },
              kw: { zh: ['家庭', '太太', '老婆', '妻子', '丈夫', '婚姻', '夫妻', '孩子', '兒子', '女兒', '子女', '父親', '爸爸', '父母', '吵架', '家人', '岳父', '媽媽', '親子'], en: ['family', 'wife', 'husband', 'marriage', 'married', 'children', 'kids', 'son', 'daughter', 'father', 'parent', 'dad', 'quarrel', 'argue', 'home', 'spouse'] },
              open: { zh: '家庭是最甜也最容易受傷的地方。願意為家人尋求聖言，本身就是愛的表現。', en: 'Home is the sweetest place and also where we are most easily hurt. Seeking God\'s Word for your family is itself an act of love.' },
              verses: ['eph5_25', 'eph6_4', 'jos24_15', 'col3_13'],
              reflect: { zh: '作丈夫與父親，是天主託付的使命。大聖若瑟沒有留下一句話，卻以守護、工作與陪伴，成為聖家的支柱。有時，最有力的福傳，是在家中耐心、溫柔地愛。', en: 'Being a husband and father is a mission entrusted by God. St. Joseph left us no recorded words, yet through protection, work and presence he became the pillar of the Holy Family. Sometimes the strongest evangelization is patient, gentle love at home.' },
              steps: { zh: ['今晚放下手機十五分鐘，專心聽太太或孩子說話。', '向家人說一句感謝，或為一次過失誠心道歉。', '每天與家人一起唸一次飯前禱或晚禱。'], en: ['Tonight put your phone down for fifteen minutes and listen to your wife or children.', 'Say one word of thanks to a family member, or sincerely apologize for a fault.', 'Pray together once a day: a grace before meals or an evening prayer.'] },
              prayer: { zh: '聖家的主，求你祝福我的家庭。賜我像若瑟一樣，以愛心、耐性與勇氣守護我所愛的人。阿們。', en: 'Lord of the Holy Family, bless my family. Make me, like Joseph, a guardian of those I love, with love, patience and courage. Amen.' },
              related: ['joseph', 'anger'] },

            { id: 'anger', icon: 'fa-fire', label: { zh: '憤怒與衝突', en: 'Anger & conflict' },
              kw: { zh: ['憤怒', '生氣', '發脾氣', '動怒', '火滾', '惱', '衝突', '爭執', '吵'], en: ['angry', 'anger', 'temper', 'rage', 'furious', 'conflict', 'argument', 'fight', 'irritated', 'frustrated'] },
              open: { zh: '憤怒本身是一種感受，並不一定是罪；重要的是我們怎樣處理它。', en: 'Anger is a feeling and not necessarily a sin; what matters is what we do with it.' },
              verses: ['jas1_19', 'eph4_26', 'prov15_1'],
              reflect: { zh: '憤怒背後常有未被滿足的需要：想被尊重、被明白，或感到無力。把它帶到祈禱中，問自己：我真正在意的是什麼？然後選擇一個不傷害人的回應。', en: 'Behind anger there is often an unmet need: to be respected, to be understood, or a sense of powerlessness. Bring it into prayer and ask: what do I really care about? Then choose a response that does not harm anyone.' },
              steps: { zh: ['發怒前先停三秒，深呼吸一下才開口。', '把怒氣背後的真正需要寫下來。', '若傷害了別人，盡快主動道歉。'], en: ['Pause for three seconds and breathe before you speak.', 'Write down the real need behind your anger.', 'If you hurt someone, apologize as soon as you can.'] },
              prayer: { zh: '主，求你平息我內心的怒火，使我快於聆聽，慢於動怒。讓我的言語帶來和平，而不是傷害。阿們。', en: 'Lord, calm the fire within me. Make me quick to listen and slow to anger. Let my words bring peace and not harm. Amen.' },
              related: ['forgiveness', 'family'] },

            { id: 'temptation', icon: 'fa-shield-halved', label: { zh: '誘惑與軟弱', en: 'Temptation & weakness' },
              kw: { zh: ['誘惑', '試探', '軟弱', '犯罪', '上癮', '沉迷', '色情', '賭', '酒', '習慣', '屢犯', '內疚', '愧疚', '羞愧', '罪惡感'], en: ['temptation', 'tempted', 'sin', 'addiction', 'addicted', 'porn', 'gambling', 'alcohol', 'habit', 'guilt', 'guilty', 'shame', 'relapse', 'weak'] },
              open: { zh: '謝謝你坦誠說出來。軟弱並不使你失去天主的愛；真正的危險，是躲藏與羞愧。', en: 'Thank you for being honest. Weakness does not cost you God\'s love; the real danger is hiding and shame.' },
              verses: ['cor10_13', 'jn1_9', 'mt26_41'],
              reflect: { zh: '伯多祿曾否認主，卻因悔改而成為磐石。天主在每次試探中都預備一條出路，其中一條，就是向可信的人說出來。你不是靠自己的意志力獨自作戰。', en: 'Peter denied the Lord, yet through repentance he became a rock. God provides a way out in every temptation, and one way out is to speak to someone you trust. You are not fighting on willpower alone.' },
              steps: { zh: ['向一位可信任的弟兄或司鐸說出你的掙扎；說出來本身已是力量。', '辦告解：不是為了受罰，而是為了重新站起來。', '為自己定下實際的防線（如使用電子產品的時間與場合）。', '若涉及上癮，請同時尋求專業輔導或互助小組。'], en: ['Tell a trusted brother or a priest about your struggle; speaking up is already strength.', 'Go to Confession: not to be punished, but to stand up again.', 'Set practical safeguards (for example, when and where you use devices).', 'If this involves addiction, please also seek professional counselling or a support group.'] },
              prayer: { zh: '慈悲的天主，我常常軟弱。求你扶起我，賜我誠實的心與重新開始的勇氣，並讓我在弟兄的陪伴中得到力量。阿們。', en: 'Merciful God, I am often weak. Lift me up and give me an honest heart and the courage to begin again, and strength through the company of my brothers. Amen.' },
              related: ['forgiveness', 'liturgy-confession'] },

            { id: 'lonely', icon: 'fa-user', label: { zh: '孤單與友誼', en: 'Loneliness & friendship' },
              kw: { zh: ['孤單', '寂寞', '孤獨', '朋友', '沒有朋友', '友誼', '被忽略', '冇朋友'], en: ['lonely', 'loneliness', 'alone', 'friends', 'friendship', 'isolated', 'no friends', 'brotherhood'] },
              open: { zh: '很多男士習慣把感受藏在心裡，所以孤單常常沒有人知道。你說出來，是很勇敢的。', en: 'Many men are used to keeping feelings inside, so loneliness often goes unnoticed. Saying it out loud takes courage.' },
              verses: ['eccl4_9', 'prov27_17', 'mt18_20'],
              reflect: { zh: '天主沒有把我們造成孤島。小團體的意義，就是讓我們彼此扶起、互相磨礪。友誼需要時間與主動，但值得。', en: 'God did not make us islands. The point of a small community is to lift one another up and sharpen one another. Friendship takes time and initiative, but it is worth it.' },
              steps: { zh: ['這個星期主動聯絡一位好久沒見的弟兄。', '出席磐石的下一次聚會，哪怕只是坐著聽。', '向天主說出你的孤單，不必用漂亮的話。'], en: ['This week reach out to a brother you have not seen for a long time.', 'Come to the next Petros gathering, even if you only sit and listen.', 'Tell God about your loneliness, no fancy words needed.'] },
              prayer: { zh: '主耶穌，你明白被遺棄的滋味。求你陪伴我，並賜我勇氣去接近別人，也讓我成為別人的朋友。阿們。', en: 'Lord Jesus, you know what it is to be abandoned. Be with me, give me courage to reach out, and make me a friend to others. Amen.' },
              related: ['prayer', 'rock'] },

            { id: 'doubt', icon: 'fa-circle-question', label: { zh: '信仰疑惑', en: 'Doubts about faith' },
              kw: { zh: ['懷疑', '疑惑', '疑問', '不信', '信德', '天主在哪', '祈禱無用', '失去信心', '冷淡'], en: ['doubt', 'doubts', 'doubting', 'god exists', 'lukewarm', 'lost faith', 'where is god', 'don\'t believe'] },
              open: { zh: '有疑問，並不代表你沒有信德。許多聖人都曾經歷黑夜，疑問往往是更深認識天主的入口。', en: 'Having questions does not mean you lack faith. Many saints went through dark nights, and doubts are often a doorway to knowing God more deeply.' },
              verses: ['lk17_5', 'jn20_29', 'mt14_31'],
              reflect: { zh: '多默要伸手探入主的傷痕才肯相信，主沒有責備他，反而親自邀請他。伯多祿在水上下沉時，主立即伸手拉住他。誠實地把疑問帶到天主面前，也是一種祈禱。', en: 'Thomas wanted to touch the Lord\'s wounds before believing, and the Lord did not scold him but invited him. When Peter began to sink, Jesus immediately stretched out his hand. Bringing your honest questions to God is itself a prayer.' },
              steps: { zh: ['把你的疑問寫下來，不要壓抑它們。', '找司鐸、慕道班導師或弟兄一起探討；很多問題都有人思考過。', '繼續參與彌撒與祈禱，即使感覺「乾枯」。信德有時不是感覺，而是堅持。'], en: ['Write your questions down instead of suppressing them.', 'Talk them through with a priest, a catechist or a brother; others have thought about these questions.', 'Keep going to Mass and praying, even when it feels dry. Faith is sometimes not a feeling but perseverance.'] },
              prayer: { zh: '主，我信，但求你補助我的不足。請在我的疑惑中向我顯示你自己，並賜我謙遜去尋求。阿們。', en: 'Lord, I believe; help my unbelief. Show yourself to me in my doubts and give me the humility to keep seeking. Amen.' },
              related: ['prayer', 'rock'] },

            { id: 'suffering', icon: 'fa-heart-crack', label: { zh: '悲傷、疾病與苦難', en: 'Grief, illness & suffering' },
              kw: { zh: ['悲傷', '難過', '傷心', '喪親', '去世', '離世', '死亡', '哀傷', '疾病', '生病', '癌', '病痛', '痛苦', '手術', '住院', '失去', '喪禮'], en: ['grief', 'grieving', 'sad', 'sadness', 'loss', 'died', 'death', 'passed away', 'illness', 'sick', 'cancer', 'pain', 'suffering', 'hospital', 'surgery', 'mourning'] },
              open: { zh: '我很遺憾你正經歷這些。無論你有多難過，都不必假裝堅強；天主願意靠近心靈破碎的人。', en: 'I am sorry you are going through this. However heavy it is, you do not have to pretend to be strong; God draws near to the brokenhearted.' },
              verses: ['ps34_19', 'mt5_4', 'jn11_25', 'rev21_4'],
              reflect: { zh: '耶穌在拉匝祿的墳前也哭了。眼淚不是缺乏信德，而是愛的表現。在最黑暗的日子，教會不是要你解釋苦難，而是陪你走過。', en: 'Jesus wept at the tomb of Lazarus. Tears are not a lack of faith; they are an expression of love. In the darkest days the Church does not ask you to explain suffering, but walks with you through it.' },
              steps: { zh: ['容許自己哭泣、休息，也接受別人的陪伴與飯餐。', '為逝者祈禱，或為他們奉獻彌撒。', '若悲傷持續很久或影響生活，請尋求專業輔導或醫生協助；若是疾病，請按醫生的指示治療。'], en: ['Allow yourself to cry and rest, and accept the company and meals others offer.', 'Pray for the departed, or have a Mass offered for them.', 'If grief lasts a long time or affects daily life, please seek counselling or medical help; for illness, follow your doctor\'s advice.'] },
              prayer: { zh: '主，你是安慰者。求你親自擦乾我們的眼淚，賜我們力量，並使逝去的親人安息在你的平安中。阿們。', en: 'Lord, you are the Comforter. Wipe away our tears yourself, give us strength, and let our loved ones who have died rest in your peace. Amen.' },
              related: ['rock', 'lonely'] },

            { id: 'gratitude', icon: 'fa-sun', label: { zh: '感恩與喜樂', en: 'Gratitude & joy' },
              kw: { zh: ['感恩', '感謝', '喜樂', '開心', '高興', '恩典', '祝福', '好消息', '多謝'], en: ['thanks', 'thank', 'grateful', 'gratitude', 'joy', 'happy', 'blessed', 'blessing', 'good news'] },
              open: { zh: '太好了！懂得感恩，是靈修生活很重要的一環。讓我們一起把這份喜樂獻給天主。', en: 'Wonderful! Gratitude is an important part of the spiritual life. Let us offer this joy to God.' },
              verses: ['th5_16', 'ps103_2'],
              reflect: { zh: '感恩不是只在順境中才有。習慣每天數算天主的恩惠，會改變我們看世界的角度，也使我們更容易與別人分享。', en: 'Gratitude is not only for good times. Counting God\'s blessings each day changes how we see the world and makes it easier to share with others.' },
              steps: { zh: ['寫下今天三件值得感恩的事。', '向一位曾幫助過你的人說聲多謝。', '在下次彌撒中，把這份感恩獻給天主。'], en: ['Write down three things you are grateful for today.', 'Thank someone who has helped you.', 'At your next Mass, offer this gratitude to God.'] },
              prayer: { zh: '天父，感謝你賜給我的一切。願我的生活成為一首感恩的詩歌，讚美你的名。阿們。', en: 'Father, thank you for everything you have given me. May my life be a song of thanksgiving to your name. Amen.' },
              related: ['prayer', 'purpose'] },

            { id: 'decision', icon: 'fa-signs-post', label: { zh: '抉擇與方向', en: 'Decisions & direction' },
              kw: { zh: ['抉擇', '決定', '選擇', '方向', '迷茫', '迷惘', '轉工', '轉行', '移民', '猶豫', '前途', '怎麼辦', '識別'], en: ['decision', 'decide', 'choose', 'choice', 'direction', 'lost', 'confused', 'crossroads', 'discern', 'discernment', 'emigrate', 'career change'] },
              open: { zh: '面對重要的抉擇，感到猶豫是很自然的。我們可以一起把它帶到天主面前。', en: 'Hesitation before an important decision is natural. Let us bring it before God together.' },
              verses: ['prov3_5', 'ps119_105', 'jas1_5'],
              reflect: { zh: '識別不是等到所有事情都清晰才行動，而是在祈禱、聖言、有智慧的意見與內心的平安之間，一步一步看見方向。天主常給我們足夠的光看見下一步。', en: 'Discernment does not mean waiting until everything is clear; it means seeing the way step by step through prayer, Scripture, wise counsel and interior peace. God usually gives enough light for the next step.' },
              steps: { zh: ['把各個選項的利弊寫下來，並問：哪一個讓我更接近愛天主與愛人？', '安排一段安靜時間祈禱（例如一個週末），求天主賜智慧。', '與成熟的信友或司鐸，以及家人傾談，再作決定。'], en: ['Write the pros and cons of each option and ask: which draws me closer to loving God and others?', 'Set aside quiet time to pray (a weekend, for example) and ask God for wisdom.', 'Talk with a mature Christian or a priest, and with your family, before deciding.'] },
              prayer: { zh: '主，你是我腳前的燈。求你光照我，使我在抉擇中尋求你的旨意，並有勇氣走出下一步。阿們。', en: 'Lord, you are the lamp for my feet. Enlighten me so that I seek your will in my choices and have the courage to take the next step. Amen.' },
              related: ['anxiety', 'prayer'] },

            { id: 'forgiveness', icon: 'fa-handshake', label: { zh: '寬恕與和好', en: 'Forgiveness' },
              kw: { zh: ['寬恕', '原諒', '饒恕', '怨恨', '仇恨', '嫉妒', '不原諒', '和好', '道歉', '傷害', '背叛'], en: ['forgive', 'forgiveness', 'resent', 'resentment', 'hatred', 'grudge', 'hurt', 'betrayed', 'reconcile', 'apologize', 'apology'] },
              open: { zh: '放下傷痛，往往比想像中艱難。你願意正視它，已經是走向自由的開始。', en: 'Letting go of hurt is often harder than we imagine. Facing it is already the beginning of freedom.' },
              verses: ['mt6_14', 'col3_13', 'mt18_21'],
              reflect: { zh: '寬恕不是說對方沒有錯，也不是立即忘記，而是決定不再讓傷害主宰自己。這是一個過程，也是一份恩寵；我們可以每天求主幫助我們走多一步。', en: 'Forgiving does not mean the other person was not wrong, nor that we forget at once. It means deciding not to let the hurt rule us. It is a process and a grace; each day we can ask the Lord to help us take one more step.' },
              steps: { zh: ['在祈禱中把那個人帶到天主面前，求天主祝福他。', '如果安全且適合，主動踏出和好的第一步。', '若傷害涉及虐待或危險，請先保障自己的安全並尋求專業協助。'], en: ['In prayer, bring that person before God and ask God to bless them.', 'If it is safe and appropriate, take the first step toward reconciliation.', 'If the hurt involved abuse or danger, protect your safety first and seek professional help.'] },
              prayer: { zh: '主耶穌，你在十字架上寬恕了迫害你的人。求你醫治我內心的傷痛，賜我力量去寬恕，也請求被寬恕。阿們。', en: 'Lord Jesus, on the cross you forgave those who harmed you. Heal the wounds within me and give me strength to forgive and to be forgiven. Amen.' },
              related: ['liturgy-confession', 'anger'] },

            { id: 'prayer', icon: 'fa-hands-praying', label: { zh: '祈禱與靈修', en: 'Prayer & spirituality' },
              kw: { zh: ['祈禱', '禱告', '靈修', '默想', '乾枯', '沒時間', '怎樣祈禱', '如何祈禱', '聖經', '讀經'], en: ['prayer', 'pray', 'dryness', 'dry', 'how to pray', 'meditate', 'meditation', 'bible', 'spiritual'] },
              open: { zh: '想祈禱，本身已是聖神的工作。祈禱不需要完美，只需要誠實與恆心。', en: 'Wanting to pray is already the work of the Holy Spirit. Prayer does not need to be perfect, only honest and faithful.' },
              verses: ['lk11_9', 'mt6_6', 'rom8_26'],
              reflect: { zh: '祈禱不是向天主「交功課」，而是與愛我們的天父相處。感到乾枯、分心時，不必自責：把心溫柔地帶回來，這也是祈禱。', en: 'Prayer is not “handing in homework” to God but spending time with the Father who loves us. When you feel dry or distracted, do not blame yourself: gently bringing your heart back is also prayer.' },
              steps: { zh: ['每天固定十分鐘，同一個時間、同一個地方。', '用「神讀」四步默想一段福音：誦讀、默想、祈禱、默觀。', '分心時不要灰心，只管溫柔地把心帶回來。'], en: ['Set aside ten minutes at the same time and place each day.', 'Pray a short Gospel passage with the four steps of lectio divina: read, reflect, pray, rest.', 'When you get distracted, do not be discouraged; gently bring your heart back.'] },
              prayer: { zh: '聖神，請教我祈禱。我不知道怎樣祈求才對，求你親自在我內祈禱，使我更認識天父。阿們。', en: 'Holy Spirit, teach me to pray. I do not know how to pray as I ought; pray within me and lead me to know the Father more deeply. Amen.' },
              related: ['liturgy-lectio', 'doubt'] },

            { id: 'perseverance', icon: 'fa-mountain', label: { zh: '疲憊與堅持', en: 'Tiredness & perseverance' },
              kw: { zh: ['累', '疲倦', '疲憊', '灰心', '失望', '放棄', '氣餒', '沒動力', '低落', '失敗', '挫折'], en: ['tired', 'exhausted', 'discouraged', 'give up', 'failure', 'setback', 'motivation', 'weary'] },
              open: { zh: '累了、灰心了，是很人性的。你不是軟弱，只是需要被扶持和再得力量。', en: 'Being tired and discouraged is very human. You are not weak; you simply need support and fresh strength.' },
              verses: ['is40_31', 'gal6_9', 'lam3_22'],
              reflect: { zh: '「每天早晨，都是新的。」天主的憐憫不是一次過用完。今天做得不夠好的，可以明天重新開始；我們不是靠自己的力量，而是靠仰望上主而得力。', en: '“They are new every morning.” God\'s mercies do not run out. What went badly today can begin again tomorrow; we are renewed not by our own strength but by hoping in the LORD.' },
              steps: { zh: ['今天只定一個很小、可完成的目標。', '安排真正的休息（睡眠、散步、與朋友相聚），休息也是責任。', '把你的疲憊告訴一位信得過的弟兄。'], en: ['Set just one small, achievable goal for today.', 'Schedule real rest (sleep, a walk, time with friends); rest is also a responsibility.', 'Tell a trusted brother how tired you are.'] },
              prayer: { zh: '主，我累了。求你更新我的力量，讓我像展翅的鷹，在你內重新得力。阿們。', en: 'Lord, I am tired. Renew my strength so that I may soar like an eagle, restored in you. Amen.' },
              related: ['work', 'prayer'] },

            { id: 'purpose', icon: 'fa-lightbulb', label: { zh: '使命與福傳', en: 'Purpose & witness' },
              kw: { zh: ['使命', '目標', '意義', '福傳', '見證', '作證', '召叫', '聖召', '人生意義'], en: ['purpose', 'meaning', 'mission', 'calling', 'vocation', 'witness', 'evangelize', 'evangelization'] },
              open: { zh: '尋找人生的意義與使命，是每個人心底的渴望。天主對你早有一個計劃。', en: 'Looking for meaning and mission is a longing deep in every heart. God already has a plan for you.' },
              verses: ['mt5_16', 'jer29_11'],
              reflect: { zh: '福傳不一定在講台上，更多是在辦公室、家中與社區裡，以誠實、公義與愛心活出信仰。你的日常，就是天主派給你的「福傳場」。', en: 'Evangelization is not always from a pulpit; most often it is lived in offices, homes and neighbourhoods through honesty, justice and love. Your everyday life is the mission field God has given you.' },
              steps: { zh: ['這個星期，在工作或家中做一件不為人知的善事。', '留意一位需要被關心的人，主動問候他。', '參加磐石的社區關懷探訪，在服務中發現使命。'], en: ['This week, do one good deed at work or at home that no one will know about.', 'Notice someone who needs care and reach out to them.', 'Join a Petros community visit and discover your mission through service.'] },
              prayer: { zh: '主，使我成為世上的光和鹽。求你讓我的言行，使人看見你的愛。阿們。', en: 'Lord, make me light and salt in the world. Let my words and actions show others your love. Amen.' },
              related: ['rock', 'gratitude'] },

            { id: 'money', icon: 'fa-coins', label: { zh: '金錢與生活', en: 'Money & provision' },
              kw: { zh: ['金錢', '錢', '經濟', '財務', '債', '欠債', '供樓', '生活費', '入息', '窮', '儲蓄', '貧窮'], en: ['money', 'financial', 'finances', 'debt', 'mortgage', 'income', 'poor', 'bills', 'afford', 'savings'] },
              open: { zh: '經濟壓力是許多家庭的重擔。你的擔憂是真實的，天主也看見。', en: 'Financial pressure is a heavy load for many families. Your concern is real, and God sees it.' },
              verses: ['mt6_33', 'heb13_5'],
              reflect: { zh: '耶穌並不輕視我們的需要，祂邀請我們先尋求天主的國，並相信祂的照顧。這並不是叫我們不工作或不負責任，而是不讓金錢成為生活的主人。（這裏不能提供專業理財意見。）', en: 'Jesus does not dismiss our needs; he invites us to seek God\'s kingdom first and to trust his care. This is not an excuse to stop working or to be irresponsible; it means not letting money become the master of our lives. (This is not professional financial advice.)' },
              steps: { zh: ['誠實列出收入與支出，與太太或信任的人一起面對。', '善用社會及堂區的支援資源（例如堂區慈善組織、政府援助）。', '定下一個小而穩定的施捨習慣，提醒自己一切都是恩賜。'], en: ['Write down income and expenses honestly and face them together with your wife or someone you trust.', 'Make use of social and parish support (such as parish charity groups or government assistance).', 'Set a small, steady habit of almsgiving to remind yourself that everything is gift.'] },
              prayer: { zh: '天父，你知道我們需要什麼。求你賜我們日用的食糧，並使我們在貧乏與豐足中都信賴你。阿們。', en: 'Father, you know what we need. Give us our daily bread, and let us trust you in both scarcity and plenty. Amen.' },
              related: ['anxiety', 'work'] },

            { id: 'rock', icon: 'fa-mountain-sun', label: { zh: '磐石與根基', en: 'The Rock & foundations' },
              kw: { zh: ['磐石', '根基', '基礎', '伯多祿', '彼得'], en: ['rock', 'foundation', 'foundations', 'petros', 'peter'] },
              open: { zh: '「磐石」正是我們團體的名字，也是天主在聖經中常用來形容自己的稱呼。', en: '“Rock” is the name of our group, and it is also a title God often uses of himself in Scripture.' },
              verses: ['is26_4', 'mt7_24', 'mt16_18', 'ps18_3'],
              reflect: { zh: 'Petros 是希臘文的「磐石」。耶穌把這名字賜給也曾軟弱、曾否認祂的西滿。真正的磐石不是不會跌倒的人，而是把生命建基於基督、並在跌倒後重新站起來的人。', en: 'Petros is Greek for “rock”. Jesus gave this name to Simon, who was weak and even denied him. A true rock is not someone who never falls but someone who builds his life on Christ and rises again after falling.' },
              steps: { zh: ['想一想：現在我的生活建基於什麼？成就、金錢，還是基督？', '每天讀一句瑪竇福音 7:24-25，並把它活出來。', '與團體的弟兄分享你的「根基」。'], en: ['Ask yourself: what is my life built on right now: achievements, money or Christ?', 'Read Matthew 7:24-25 each day and try to live it out.', 'Share your “foundation” with the brothers of the group.'] },
              prayer: { zh: '主耶穌，你是我的磐石。求你使我的生命建基於你，讓風浪來臨時，我仍然屹立不倒。阿們。', en: 'Lord Jesus, you are my rock. Build my life on you so that when storms come I will stand firm. Amen.' },
              related: ['joseph', 'doubt'] },

            { id: 'joseph', icon: 'fa-hammer', label: { zh: '大聖若瑟', en: 'St. Joseph' },
              kw: { zh: ['若瑟', '聖若瑟', '主保', '養父'], en: ['joseph', 'st joseph', 'saint joseph', 'patron saint'] },
              open: { zh: '大聖若瑟是我們男士團體的主保，也是所有丈夫與父親的好榜樣。', en: 'St. Joseph is the patron of our men\'s group and a good model for all husbands and fathers.' },
              verses: ['mt1_24', 'mt2_14'],
              reflect: { zh: '若瑟沒有留下一句話，卻在夢中聽見天主的聲音後，立即行動：接納瑪利亞、帶著聖家逃往埃及。他的靈修，就是安靜聆聽、迅速順命、默默守護。', en: 'Joseph left no recorded words, yet when God spoke to him in dreams he acted at once: he welcomed Mary and took the Holy Family to Egypt. His spirituality is quiet listening, prompt obedience and silent protection.' },
              steps: { zh: ['今天安靜五分鐘，問天主：「我當守護的人是誰？」', '用行動愛家人：做一件實際的家務或照顧。', '3 月 19 日與 5 月 1 日，留意聖若瑟的慶日，與弟兄一同慶祝。'], en: ['Be still for five minutes today and ask God: “Whom am I called to protect?”', 'Love your family in action: do one practical chore or act of care.', 'Remember the feasts of St. Joseph on 19 March and 1 May and celebrate with your brothers.'] },
              prayer: { zh: '大聖若瑟，家庭與勞工的主保，求你為我們轉禱，使我們像你一樣誠實、勤勞、忠信地守護所愛的人。阿們。', en: 'St. Joseph, patron of families and workers, pray for us that, like you, we may protect those we love with honesty, diligence and faithfulness. Amen.' },
              related: ['family', 'rock'] }
        ].filter(t => !t.skip);

