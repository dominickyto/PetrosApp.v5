            const e = LIT.find(x => x.id === entryId); if (!e) return;
            const pts = e.p[l === 'en' ? 'en' : 'zh'].slice(0, 3);
            const extra = e.id === 'prayer-hours' ? `<p><a data-ibrev href="${IBREV_URL}" target="_blank" rel="noopener noreferrer" class="text-amber-300 underline">${esc(L(S['lit.ibrevLine'] ? { zh: S['lit.ibrevLine'][0], en: S['lit.ibrevLine'][1] } : '', l))}</a></p>` : '';
            chatAppend(`${head('liturgyHead', l)}<p class="font-bold font-serif">${esc(L(e.t, l))}</p><p>${esc(L(e.s, l))}</p><ul class="space-y-1">${pts.map(p => `<li>${esc(p)}</li>`).join('')}</ul>${extra}<button data-chip="openlit:${e.id}" class="text-[11px] text-rose-300 hover:text-rose-200 inline-flex items-center gap-1.5"><i class="fa-solid fa-book-open"></i> ${esc(L(CHAT.L.full, l))}</button>`, BOT);
            chat.last = null;
            const chips = [{ act: 'litmenu', label: L(CHAT.L.liturgy, l), icon: 'fa-church' }, { act: 'topic:prayer', label: L(getTopic('prayer').label, l), icon: 'fa-hands-praying' }, { act: 'daily', label: L(CHAT.L.daily, l), icon: 'fa-sun' }];
            setChips(chips);
        }
        function replyFaq(id, l) {
            const f = getFaq(id); if (!f) { replyText('fallback', l); return startChips(); }
            const i = l === 'en' ? 'en' : 'zh';
            const paras = f.a[i];
            const vs = f.verses.slice(0, FAQ_FOLLOW_VERSES).filter(v => V[v]);
            const body = paras.map(p => `<p>${esc(p).replace(/\n/g, '<br>')}</p>`).join('');
            const share = plainShare([L(f.t, l), paras[0]].concat(vs.length ? [V[vs[0]].r[l === 'en' ? 1 : 0] + '\n' + (l === 'en' ? V[vs[0]].en : V[vs[0]].zh)] : []));
            chatAppend(`<p class="font-bold font-serif text-petros-lime">${esc(L(f.t, l))}</p>${body}${vs.length ? head('verse', l) + vs.map(v => verseHtml(v, l)).join('') : ''}${shareBtn(share, l)}`, BOT);
            chat.last = null;
            const chips = [];
            (f.related || []).forEach(r => {
                if (r.startsWith('topic:')) { const tp = getTopic(r.slice(6)); if (tp) chips.push({ act: r, label: L(tp.label, l), icon: tp.icon }); }
                else { const rf = getFaq(r); if (rf) chips.push({ act: 'faq:' + r, label: L(rf.t, l), icon: rf.icon }); }
            });
            chips.push({ act: 'pray', label: L(CHAT.L.pray, l), icon: 'fa-hands-praying' });
            chips.push({ act: 'faqmenu', label: L(CHAT.L.faq, l), icon: 'fa-circle-question' });
            chips.push({ act: 'litmenu', label: L(CHAT.L.liturgy, l), icon: 'fa-church' });
            setChips(chips);
        }
        function replyFaqMenu(l) {
            chatAppend(esc(l === 'en' ? 'Which question about the faith would you like to explore? Tap one below, or type your own (for example “Who is Jesus?” or “Explain the Beatitudes”).' : '你想認識信仰的哪個問題？可以點選下面的題目，或直接輸入問題（例如「誰是耶穌？」「請解釋真福八端」）。'), BOT);
            setChips(FAQ.map(f => ({ act: 'faq:' + f.id, label: L(f.t, l), icon: f.icon })));
        }
        function replyLitMenu(l) {
            const ids = ['mass-structure', 'mass-communion', 'sacr-confession', 'year-lent', 'prayer-rosary', 'year-colors', 'prayer-hours'];
            chatAppend(esc(l === 'en' ? 'Which part of the liturgy would you like to explore? Tap one below, or type your own question (for example “how do I receive Communion?”).' : '你想認識禮儀的哪一部分？可以點選下面的題目，或直接輸入問題（例如「點樣領聖體？」）。'), BOT);
            setChips(ids.map(id => { const e = LIT.find(x => x.id === id); return { act: 'lit:' + id, label: L(e.t, l), icon: e.icon }; }));
        }
        function replyText(key, l) {
            const o = CHAT[key]; const v = o[l === 'en' ? 'en' : 'zh'];
            chatAppend(esc(Array.isArray(v) ? pick(v) : v), BOT);
        }
        function replyCrisis(l) {
            const txt = esc(L(CHAT.crisis, l)).replace(/\n/g, '<br>').replace(/(\d{4} \d{4}|999)/g, m => `<a class="underline font-bold text-amber-300" href="tel:${m.replace(/\s/g, '')}">${m}</a>`);
            chatAppend(txt, 'chat-bubble bg-red-950/50 p-3 rounded-2xl text-slate-100 border border-red-500/40 leading-relaxed');
            setChips([{ act: 'pray', label: L(CHAT.L.pray, l), icon: 'fa-hands-praying' }]);
        }

        // Decide how to answer a typed message
        function understand(raw) {
            const text = raw.toLowerCase().trim();
            const l = detectLang(raw);
            if (CRISIS_KW.zh.some(k => text.includes(k)) || CRISIS_KW.en.some(k => text.includes(k))) return { kind: 'crisis', l };
            const short = text.length <= 20;
            if (short && /^(hi|hello|hey|你好|您好|哈囉|哈啰|平安|主內平安|早晨|早安|晚安|good (morning|evening))/.test(text)) return { kind: 'hello', l };
            if (/(你是誰|你係邊個|你是誰|who are you|are you (an )?(ai|bot|human|real)|你是機器|你係唔係真人)/.test(text)) return { kind: 'about', l };
            if (short && /(thank|thx|多謝|謝謝|唔該|謝了|感謝你)/.test(text)) return { kind: 'thanks', l };
            if (/(為我祈禱|幫我祈禱|替我祈禱|pray for me|pray with me|say a prayer|a prayer for me)/.test(text)) return { kind: 'pray', l };
            if (short && chat.last && /(再來|另一|還有|再一|繼續|more|another|next one|go on)/.test(text)) return { kind: 'more', l };
            if (/(今日|今天|每日|daily|today).{0,8}(默想|經文|聖言|verse|meditation|reading|word)/.test(text) || /^(默想|daily)/.test(text)) return { kind: 'daily', l };
            const wantsLit = /(彌撒|禮儀|聖事|日課|\bmass\b|liturgy|sacrament|breviary)/.test(text);
            const q = /(如何|怎樣|點樣|點解|為什麼|為甚麼|什麼是|甚麼是|是什麼|有什麼|what is|what are|how do|how to|why|meaning|can i|should i)/.test(text);
            let bestT = null, bestTS = 0;
            TOPICS.forEach(tp => { const s = scoreKw(text, tp.kw); if (s > bestTS) { bestTS = s; bestT = tp; } });
            let bestL = null, bestLS = 0;
            LIT.forEach(e => { const s = scoreLit(text, e); if (s > bestLS) { bestLS = s; bestL = e; } });
            let bestF = null, bestFS = 0;
            FAQ.forEach(f => { const s = scoreFaq(text, f); if (s > bestFS) { bestFS = s; bestF = f; } });
            if (bestF && bestFS >= 2 && bestFS >= bestTS && bestFS >= bestLS) return { kind: 'faq', id: bestF.id, l };
            if (bestL && bestLS >= 1 && (bestLS > bestTS || (bestLS === bestTS && (q || wantsLit)) || (wantsLit && bestTS <= 1))) return { kind: 'lit', id: bestL.id, l };
            if (bestT) return { kind: 'topic', id: bestT.id, l };
            if (wantsLit) return { kind: 'litmenu', l };
            return { kind: 'fallback', l, raw };
        }
        function runAction(a, l) {
            l = l || lang;
            if (a.kind === 'crisis') return replyCrisis(l);
            if (a.kind === 'hello') { replyText('hello', l); return startChips(); }
            if (a.kind === 'about') { replyText('about', l); return startChips(); }
            if (a.kind === 'thanks') { replyText('thanks', l); return followChips(chat.last, l); }
            if (a.kind === 'pray') return replyPray(l);
            if (a.kind === 'more') return replyTopic(chat.last, l, true);
            if (a.kind === 'daily') return replyDaily(l);
            if (a.kind === 'faq') return replyFaq(a.id, l);
            if (a.kind === 'lit') return replyLit(a.id, l);
            if (a.kind === 'litmenu') return replyLitMenu(l);
            if (a.kind === 'faqmenu') return replyFaqMenu(l);
            if (a.kind === 'topic') return replyTopic(a.id, l, false);
            replyFallback(a.raw, l);
        }
        function replyFallback(raw, l) {
            const isQ = raw && /[?？]|(是誰|是什麼|是甚麼|什麼|甚麼|點解|點樣|怎樣|如何|解釋|意思|who|what|why|how|explain|meaning)/i.test(raw);
            if (!isQ) { replyText('fallback', l); return startChips(); }
            chatAppend(esc(l === 'en'
                ? 'That is a good question, but I only carry a limited set of pre-written answers and cannot cover the whole Bible. You may tap a Faith Q&A topic below, search the Bible text online, or ask your parish priest or a brother in the group.'
                : '這是個好問題，不過我只有預先寫好的有限答案，未能涵蓋整本聖經。你可以點選下面的「信仰問答」題目、到網上聖經查閱經文，或請教堂區司鐸與團體弟兄。'), BOT);
            const chips = [{ act: 'openbible', label: l === 'en' ? 'Open the Bible online' : '開啟網上聖經', icon: 'fa-book-open' }, { act: 'faqmenu', label: L(CHAT.L.faq, l), icon: 'fa-circle-question' }, { act: 'litmenu', label: L(CHAT.L.liturgy, l), icon: 'fa-church' }, { act: 'daily', label: L(CHAT.L.daily, l), icon: 'fa-sun' }];
            setChips(chips);
        }
        function respond(action) {
            if (chat.busy) return;
            chat.busy = true;
            const l = action.l || lang;
            const typing = chatAppend(`<i class="fa-solid fa-circle-notch fa-spin"></i> ${esc(L(CHAT.L.typing, l))}`, 'bg-slate-800 p-3 rounded-2xl text-slate-300 border border-slate-700 italic');
            setTimeout(() => { typing.remove(); try { runAction(action, l); } finally { chat.busy = false; } }, 450);
        }
        function sendAIMessage() {
            const input = $('aiInput'); const message = input.value.trim();
            if (!message || chat.busy) return;
            initChat();
            userBubble(message);
            input.value = '';
            respond(understand(message));
        }
        function generateAIWisdom() { openModal('aiModal'); respond({ kind: 'daily', l: lang }); }

        document.addEventListener('click', e => {
            const chip = e.target.closest('[data-chip]');
            if (chip) {
                const act = chip.dataset.chip;
                if (act.startsWith('openlit:')) return openLiturgyEntry(act.slice(8));
                if (act === 'openbible') return void window.open('https://www.ccreadbible.org/chinesebible', '_blank', 'noopener');
                const labelText = chip.textContent.trim();
                if (chip.closest('#aiChips')) userBubble(labelText);
                if (act.startsWith('topic:')) respond({ kind: 'topic', id: act.slice(6), l: lang });
                else if (act.startsWith('lit:')) respond({ kind: 'lit', id: act.slice(4), l: lang });
                else if (act.startsWith('faq:')) respond({ kind: 'faq', id: act.slice(4), l: lang });
                else respond({ kind: act, l: lang });
                return;
            }
            const sh = e.target.closest('[data-share]');
            if (sh) window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(chat.shares[+sh.dataset.share] || ''), '_blank', 'noopener');
        });

        // ===================== INIT =====================
        function renderAll() {
            renderVerseVault();
            renderPrayers();
            renderLegend();
            fillCategorySelect();
            renderCalendar();
            renderLiturgyToday();
            renderLiturgy();
            document.querySelectorAll('[data-ibrev]').forEach(a => { a.href = IBREV_URL; });
            updateSharePreviewText();
            if (isOpen('qrModal')) switchQRType(currentQRMode);
            // refresh chat chips / greeting when the language changes
            const box = $('aiChatHistory');
            if (box) {
                if (box.children.length === 1 && chat.started) { box.firstElementChild.textContent = L(CHAT.greet); startChips(); }
                else if (chat.started) setChips($('aiChips').children.length ? followChipsSnapshot() : []);
            }
            const evOpen = isOpen('addEventModal');
            if (evOpen) { $('evFormTitle').textContent = $('evId').value ? t('ev.editT') : t('ev.addT'); $('evSubmitBtn').textContent = $('evId').value ? t('ev.saveEdit') : t('ev.saveAdd'); }
            else { $('evSubmitBtn').textContent = t('ev.saveAdd'); $('evFormTitle').textContent = t('ev.addT'); }
        }
        // After a language switch, offer the starting chips again in the new language
        function followChipsSnapshot() { startChips(); return Array.from($('aiChips').children).map(() => ({})); }

        document.addEventListener('DOMContentLoaded', () => {
            migrateOldEvents();
            applyLang();
            const url = window.location.href;
            if (/^https?:/i.test(url) && !url.includes('localhost') && !url.includes('127.0.0.1')) {
                const banner = $('domainWarningBanner'); if (banner) banner.style.display = 'none';
            }
        });

</script>


