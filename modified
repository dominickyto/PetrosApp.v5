            const monthNames = lang === 'en' ? ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'] : ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
            const mons = [['all', t('cal.monAll')]].concat(monthNames.map((n, i) => [i + 1, n]));
            $('calMonthBar').innerHTML = mons.map(([v, label]) =>
                `<button data-month="${v}" class="px-3 py-1.5 rounded-xl whitespace-nowrap transition ${String(activeMonth) === String(v) ? 'bg-amber-500 text-slate-950 font-bold' : 'bg-slate-800 hover:bg-slate-700 text-slate-300'}">${esc(label)}</button>`).join('');
            $('selectedYearHeaderTitle').textContent = activeYear === 'all' ? t('cal.allYears') : (activeYear === 2028 ? '2028+' : t('cal.yearFmt', { y: activeYear }));

            let list = getEvents();
            if (activeYear !== 'all') list = list.filter(e => activeYear === 2028 ? evYear(e) >= 2028 : evYear(e) === activeYear);
            if (activeMonth !== 'all') list = list.filter(e => evMonth(e) === activeMonth);

            if (!list.length) {
                box.innerHTML = `<div class="text-center py-8 bg-slate-900/60 rounded-2xl border border-slate-800 text-slate-400"><i class="fa-regular fa-calendar-xmark text-3xl mb-2 text-slate-500 block"></i><span>${esc(t('cal.empty'))}</span></div>`;
