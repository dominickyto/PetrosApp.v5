        function saveEventForm(ev) {
            ev.preventDefault();
            const err = msg => { const el = $('evFormError'); el.textContent = msg; el.classList.remove('hidden'); };
            const start = $('evStart').value, end = $('evEnd').value;
            const tz = $('evTitleZh').value.trim(), te = $('evTitleEn').value.trim();
            if (!tz && !te) return err(t('ev.errTitle'));
            if (end && end < start) return err(t('ev.errDate'));
            const data = {
                start, end, time: $('evTime').value.trim(), cat: $('evCat').value,
                title: { zh: tz, en: te },
                desc: { zh: $('evDescZh').value.trim(), en: $('evDescEn').value.trim() },
                loc: { zh: $('evLocZh').value.trim(), en: $('evLocEn').value.trim() }
            };
            const id = $('evId').value;
            if (id) {
                const defId = DEFAULT_EVENTS.find(d => String(d.id) === id);
                if (defId) overrides[defId.id] = Object.assign({ id: defId.id }, data);
                else { const i = userEvents.findIndex(u => String(u.id) === id); if (i >= 0) userEvents[i] = Object.assign({ id: userEvents[i].id }, data); }
                toast(t('ev.updated', { title: tz || te }));
            } else {
                userEvents.push(Object.assign({ id: 'u' + Date.now() }, data));
                toast(t('ev.added', { title: tz || te }));
