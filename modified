                            <button data-act="edit" data-id="${esc(e.id)}" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-[11px] px-2.5 py-1 rounded-lg border border-slate-700 transition" title="${esc(t('cal.edit'))}" aria-label="${esc(t('cal.edit'))}"><i class="fa-solid fa-pen"></i></button>
                            <button data-act="del" data-id="${esc(e.id)}" class="bg-slate-800 hover:bg-red-900/60 text-red-300 text-[11px] px-2.5 py-1 rounded-lg border border-slate-700 transition" title="${esc(t('cal.del'))}" aria-label="${esc(t('cal.del'))}"><i class="fa-solid fa-trash-can"></i></button>
