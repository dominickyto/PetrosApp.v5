                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-bold text-amber-400 flex items-center gap-1"><i class="fa-solid fa-clock"></i> ${esc(eventDateText(e))}</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full border ${cat.cls} font-semibold">${esc(catLabel(e.cat))}</span>
                            ${badge}
                        </div>
                        <h4 class="font-bold text-sm text-white font-serif">${esc(L(e.title))}</h4>
                        <p class="text-xs text-slate-400">${esc(L(e.desc))}</p>
